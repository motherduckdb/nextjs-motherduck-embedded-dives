# MotherDuck - auto-provisioned by Vercel MotherDuck integration
# https://vercel.com/integrations/motherduck
MOTHERDUCK_TOKEN=

# Database - auto-provisioned by the Supabase integration
# https://vercel.com/marketplace/supabase
POSTGRES_URL=

# AI providers - set at least one
ANTHROPIC_API_KEY=   # https://console.anthropic.com
OPENAI_API_KEY=      # https://platform.openai.com/api-keys
AI_GATEWAY_API_KEY=  # https://vercel.com/docs/ai-gateway
# Optional AI model overrides
# AI_MODEL_ANTHROPIC=claude-sonnet-4-6
# AI_MODEL_OPENAI=gpt-5.4
# AI_MODEL_GATEWAY=anthropic/claude-sonnet-4.6

# Optional NextAuth email/password auth - users sign up, sign in, and use one shared MotherDuck service account by default
# PASSWORD_AUTH_ENABLED=true
# AUTH_SECRET=generate-a-long-random-string
# MOTHERDUCK_SHARED_SERVICE_ACCOUNT_USERNAME=app_shared
# AUTH_TRUSTED_ORIGINS=https://example.com

# Optional MotherDuck auth mode - prompts each signed-in user for their own MotherDuck PAT
# MOTHERDUCK_AUTH_MODE=personal_pat
# MOTHERDUCK_PAT_ENCRYPTION_KEY=generate-a-long-random-string
# MOTHERDUCK_TOKEN_APP_NAME=motherduck-dives

# Optional - override MotherDuck API/MCP endpoints
# MOTHERDUCK_API_BASE=https://api.motherduck.com
# MOTHERDUCK_MCP_URL=https://api.motherduck.com/mcp

# Optional - override MotherDuck Postgres endpoint host for other regions
# MOTHERDUCK_PG_HOST=pg.us-east-1-aws.motherduck.com
